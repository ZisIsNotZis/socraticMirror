{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "state.schema.json",
  "title": "Socratic Mirror state v1",
  "type": "object",
  "required": [
    "version",
    "nodes",
    "scenarios",
    "history"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "concept",
          "level",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "concept": {
            "type": "object"
          },
          "level": {
            "type": "object",
            "required": [
              "unknown",
              "aware",
              "operable",
              "deep"
            ],
            "additionalProperties": false,
            "properties": {
              "unknown": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "aware": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "operable": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "deep": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "evidence": {
            "type": "object",
            "required": [
              "count",
              "question_types",
              "sharpness",
              "propagated"
            ],
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "question_types": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "sharpness": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "propagated": {
                "type": "integer",
                "minimum": 0
              },
              "dimensions": {
                "type": "object",
                "required": [
                  "identify",
                  "mechanism",
                  "application",
                  "boundary"
                ],
                "additionalProperties": false,
                "properties": {
                  "identify": {
                    "$ref": "#/$defs/dimensionEvidence"
                  },
                  "mechanism": {
                    "$ref": "#/$defs/dimensionEvidence"
                  },
                  "application": {
                    "$ref": "#/$defs/dimensionEvidence"
                  },
                  "boundary": {
                    "$ref": "#/$defs/dimensionEvidence"
                  }
                }
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "$ref": "scenario.schema.json"
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "nodes",
          "question_type",
          "scores",
          "quotes",
          "probe",
          "total",
          "row",
          "before",
          "after"
        ],
        "properties": {
          "nodes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "question_type": {
            "type": "string"
          },
          "scores": {
            "type": "object",
            "required": [
              "identify",
              "mechanism",
              "application",
              "boundary"
            ],
            "additionalProperties": false,
            "properties": {
              "identify": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3
                  },
                  {
                    "enum": [
                      "absent_asked",
                      "unverified"
                    ]
                  }
                ]
              },
              "mechanism": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3
                  },
                  {
                    "enum": [
                      "absent_asked",
                      "unverified"
                    ]
                  }
                ]
              },
              "application": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3
                  },
                  {
                    "enum": [
                      "absent_asked",
                      "unverified"
                    ]
                  }
                ]
              },
              "boundary": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3
                  },
                  {
                    "enum": [
                      "absent_asked",
                      "unverified"
                    ]
                  }
                ]
              }
            }
          },
          "quotes": {
            "type": "object"
          },
          "probe": {
            "enum": [
              "direct",
              "after_prompt"
            ]
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "maximum": 12
          },
          "row": {
            "type": "integer",
            "minimum": 0,
            "maximum": 11
          },
          "before": {
            "type": "object"
          },
          "after": {
            "type": "object"
          },
          "only": {
            "type": "array",
            "items": {
              "enum": [
                "identify",
                "mechanism",
                "application",
                "boundary"
              ]
            }
          },
          "whole_coverage": {
            "type": "boolean"
          },
          "scenario": {
            "type": "string"
          },
          "required_observables": {}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "dimensionEvidence": {
      "type": "object",
      "required": [
        "count",
        "sharpness",
        "status",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "sharpness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "status": {
          "enum": [
            "scored",
            "absent_asked",
            "unverified"
          ]
        },
        "value": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 3
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "scored"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "integer"
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
